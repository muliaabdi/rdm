{
  "manifest_version": 3,
  "key": "",
  "name": "RDM Integration",
  "version": "0.5.3",
  "description": "Automatic download interception into RDM (Rust Download Manager)",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "webRequest",
    "scripting",
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["video-overlay.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "RDM",
    "default_popup": "popup.html"
  }
}